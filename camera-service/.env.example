# Camera Service Configuration
# Copy this file to .env and fill in your values

# Railway backend URL (no trailing slash)
API_BASE_URL=https://backend-production-1348.up.railway.app/api/v1

# Backend base URL for downloading student photos (same host, no /api/v1 suffix)
BACKEND_UPLOADS_URL=https://backend-production-1348.up.railway.app/uploads

# Camera index (0 = default/first webcam)
CAMERA_INDEX=0

# Face recognition confidence threshold (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.6

# Seconds between camera scans
SCAN_INTERVAL_SECONDS=2

# School gate camera credentials (admin account on Railway backend)
CAMERA_SERVICE_EMAIL=admin@attendify.ai
CAMERA_SERVICE_PASSWORD=admin123

# School start time (HH:MM, 24-hour)
SCHOOL_START_TIME=08:30
